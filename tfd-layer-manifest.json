  },
  "logicalLayers": [
    {
      "id": "administrative_units",
      "sourceLayer": [
        "admin_units"
      ],
      "geometry": [
        "Polygon",
        "LineString"
      ],
      "minzoom": 5,
      "labelsFrom": 6,
      "purpose": "Region, prefecture, commune, canton and quartier boundaries",
      "interactive": true
    },
    {
      "id": "tfd_cadastre",
      "sourceLayer": [
        "tfd_grid",
        "tfd_localities"
      ],
      "geometry": [
        "Polygon",
        "Point"
      ],
      "minzoom": 8,
      "labelsFrom": 16,
      "purpose": "TFD grid cells, locality polygons, cell codes and hierarchy",
      "interactive": true
    },
    {
      "id": "cadastral_sheets",
      "sourceLayer": [
        "cadastral_sections"
      ],
      "geometry": [
        "Polygon"
      ],
      "minzoom": 10,
      "labelsFrom": 13,
      "purpose": "Legacy sheet/section references and optional scanned raster sheets",
      "interactive": true,
      "optionalRasterSource": "cadastral-sheets-raster"
    },
    {
      "id": "tfd_street",
      "sourceLayer": [
        "tfd_streets"
      ],
      "geometry": [
        "LineString"
      ],
      "minzoom": 9,
      "labelsFrom": 13,
      "purpose": "Road centerlines, classification, names and right-of-way",
      "interactive": true
    },
    {
      "id": "zoning",
      "sourceLayer": [
        "zoning"
      ],
      "geometry": [
        "Polygon"
      ],
      "minzoom": 9,
      "labelsFrom": 12,
      "purpose": "POS/PDU zoning polygons \u2014 zone class, density and height rules",
      "interactive": true,
      "optionalRasterSource": "planning-ortho-raster"
    },
    {
      "id": "public_spaces",
      "sourceLayer": [
        "public_spaces"
      ],
      "geometry": [
        "Polygon"
      ],
      "minzoom": 11,
      "purpose": "Public green space, plazas and collective equipment (\u00e9quipements)",
      "interactive": true
    },
    {
      "id": "planning_rules",
      "sourceLayer": [
        "planning_rules"
      ],
      "geometry": [
        "LineString"
      ],
      "minzoom": 12,
      "purpose": "Street alignments (alignements) and setbacks (reculs / emprises)",
      "interactive": true
    },
    {
      "id": "servitudes",
      "sourceLayer": [
        "servitudes"
      ],
      "geometry": [
        "Polygon",
        "LineString"
      ],
      "minzoom": 13,
      "purpose": "Urbanism regulatory constraints (servitudes d'urbanisme) \u2014 distinct from cadastral encumbrances",
      "interactive": true
    },
    {
      "id": "permits",
      "sourceLayer": [
        "permits"
      ],
      "geometry": [
        "Polygon"
      ],
      "minzoom": 14,
      "purpose": "Building permits and construction footprints (permis / emprises)",
      "interactive": true,
      "privacy": "restrict applicant PII and permit attachments"
    },
    {
      "id": "parcels",
      "sourceLayer": [
        "parcels"
      ],
      "geometry": [
        "Polygon"
      ],
      "minzoom": 12,
      "labelsFrom": 16,
      "purpose": "Parcel polygons, land use, area, valuation and title state",
      "interactive": true,
      "featureState": [
        "hover",
        "selected"
      ]
    },
    {
      "id": "encumbrances",
      "sourceLayer": [
        "encumbrances"
      ],
      "geometry": [
        "Polygon",
        "LineString"
      ],
      "minzoom": 13,
      "purpose": "Easements, servitudes, disputes and mortgages",
      "interactive": true,
      "privacy": "restrict party names and financial details"
    },
    {
      "id": "land_titles",
      "sourceLayer": [
        "land_titles"
      ],
      "geometry": [
        "Point"
      ],
      "minzoom": 14,
      "purpose": "Title/certificate number, status and issuance date",
      "interactive": true
    },
    {
      "id": "rights_holders",
      "sourceLayer": [
        "rights_holders"
      ],
      "geometry": [
        "Point"
      ],
      "minzoom": 15,
      "purpose": "Parcel-linked rights and tenure markers; no personal-name labels by default",
      "interactive": true,
      "privacy": "authorized-inspector-only for PII"
    },
    {
      "id": "parcel_boundaries",
      "sourceLayer": [
        "parcel_boundaries"
      ],
      "geometry": [
        "LineString",
        "Point"
      ],
      "minzoom": 14,
      "purpose": "Surveyed boundary lines, accuracy classes and monuments/markers",
      "interactive": true
    },
    {
      "id": "buildings",
      "sourceLayer": [
        "buildings"
      ],
      "geometry": [
        "Polygon"
      ],
      "minzoom": 14,
      "purpose": "Building footprints, floors, height and use",
      "interactive": true,
      "optionalModes": [
        "3d-buildings"
      ]
    },
    {
      "id": "addresses",
      "sourceLayer": [
        "addresses"
      ],
      "geometry": [
        "Point"
      ],
      "minzoom": 16,
      "labelsFrom": 17,
      "purpose": "House numbers, street names and geocoded address points",
      "interactive": true
    }
  ],
  "zOrder": [
    "background",
    "legacy cadastral raster / planning ortho",
    "administrative boundaries",
    "POS/PDU zoning / public spaces",
    "localities / cadastral sections / grid",
    "parcels",
    "encumbrances",
    "urbanism servitudes",
    "buildings",
    "building permits",
    "streets",
    "alignments / setbacks",
    "surveyed parcel boundaries",
    "addresses / rights / title markers",
    "labels"
  ],
  "interactionContract": {
    "hover": {
      "source": "tfd-vector",
      "sourceLayer": "parcels",
      "stateKey": "hover",
      "styleLayer": "parcels-hover"
    },
    "selected": {
      "source": "tfd-vector",
      "sourceLayer": "parcels",
      "stateKey": "selected",
      "styleLayer": "parcels-selected"
    },
    "inspect": "Read layer.metadata[\"tfd:inspector\"] and whitelist fields; never dump arbitrary properties for public users."
  },
  "mobileDefaults": {
    "disable3dByDefault": true,
    "legacyRasterOffByDefault": true,
    "maxInteractiveQueryLayers": 12,
    "labelPaddingPx": 8,
    "preferPointerMoveThrottlingMs": 32
  },
  "exportProfiles": {
    "screen": {
      "dpi": 96,
      "legacyRaster": false,
      "3d": false
    },
    "print": {
      "dpi": 300,
      "legacyRaster": "optional",
      "3d": false,
      "forceNorthUp": true,
      "includeLegend": true,
      "includeScaleBar": true,
      "includeAttribution": true
    }
  }
}
