  "styleVersion": "1.0.0",
  "crs": "EPSG:3857 for tiles; canonical source geometries may remain EPSG:4326",
  "source": "tfd-vector",
  "tileExtent": 4096,
  "recommendedBuffer": 128,
  "themes": {
